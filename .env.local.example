# Copy to `.env` for local development. `.env` is git-ignored.
# Prisma (via prisma.config.ts) and the Next.js app both read `.env`.

# ── Database (SQL Server) ────────────────────────────────────────────
DATABASE_URL="sqlserver://localhost:1433;database=pcu_cbt;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# ── Auth / sessions ─────────────────────────────────────────────────
# 1 only when the app is served over HTTPS (a reverse proxy on the LAN).
# Default 0 for the plain-HTTP LAN deployment.
SESSION_COOKIE_SECURE=0

# 0 (default): trust only the direct socket IP captured by server.js.
# 1: a trusted local reverse proxy is in front; read the rightmost
# X-Forwarded-For hop instead. Never auto-detected — get this wrong and
# the lab IP allowlist either sees every client as the same address or
# becomes spoofable.
TRUST_PROXY=0

# ── Seed ────────────────────────────────────────────────────────────
SEED_INSTITUTION_NAME="Precious Cornerstone University"
SEED_INSTITUTION_SLUG=pcu
SEED_SUPER_ADMIN_EMAIL=superadmin@pcu.edu.ng
# Required to seed in production (the seed throws if unset there).
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
# SEED_SAMPLE_DATA=1   # uncomment to also seed a demo faculty/dept/course/lecturer/student

# ── Legacy Supabase (still used by not-yet-migrated flows — Slices 3-7) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ROLE_KEY=
