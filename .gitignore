# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example template, ignore real secrets
.env.local
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude / ai tooling — do not commit
CLAUDE.md
AGENTS.md
.claude/
memory/
oems_prd.md
.mcp.json
docs/PROJECT_WALKTHROUGH.md
docs/WRITEUP_UPDATES_NEEDED.md

# supabase CLI local link/cache — machine-specific, not project state
supabase/.temp/

# personal/academic documents — not code, don't belong in a code repo
*.docx

# generated locally, contains plaintext demo credentials
seeding.md

# git worktrees used for isolated feature work
.worktrees/

# subagent-driven-development scratch workspace (ledgers, briefs, diffs)
.superpowers/

# Next.js 16 — workspace root warning (multi-project monorepo false positive)
# turbopack.root is not set intentionally for single-app use

